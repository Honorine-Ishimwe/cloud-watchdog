# Required: Azure OpenAI resource endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Required for local API-key auth (leave empty if using Managed Identity or Key Vault)
AZURE_OPENAI_API_KEY=your-api-key-here

# Optional: model deployment name (default: gpt-4.1-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Optional: set to true to read local JSON fixtures instead of calling Azure CLI
USE_FIXTURES=false

# Optional: agent loop and Azure CLI guardrails
MAX_STEPS=12
AZ_TIMEOUT=30

# Optional: cloud deployment auth (Managed Identity + Key Vault)
AZURE_USE_MANAGED_IDENTITY=false
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_SECRET_NAME=azure-openai-api-key
